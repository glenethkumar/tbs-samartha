# FleetYield AI Environment Configuration (Optional defaults)

# Server Host and Port
FLEETYIELD_HOST=127.0.0.1
FLEETYIELD_PORT=8000

# SQLite Database Path (Defaults to backend/data/fleetyield.db)
SQLITE_DB_PATH=backend/data/fleetyield.db

# Data Freshness Threshold in Hours (Default: 24.0)
STALE_DATA_THRESHOLD_HOURS=24.0

# Demand Classification Boundaries (% occupancy)
LOW_OCCUPANCY_THRESHOLD=30.0
HIGH_OCCUPANCY_THRESHOLD=70.0

# Pricing Adjustment Percentages (%)
ADJUSTMENT_LOW_DEMAND_PCT=-10.0
ADJUSTMENT_MEDIUM_DEMAND_PCT=0.0
ADJUSTMENT_HIGH_DEMAND_PCT=15.0
